{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "picstome/picstome",
    "type": "project",
    "description": "Galleries and contracts for photographers",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "endroid/qr-code": "^6.1",
        "honeybadger-io/honeybadger-laravel": "^4.6",
        "laravel/cashier": "^15.7",
        "laravel/framework": "^12",
        "laravel/nightwatch": "^1.30",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/html-to-markdown": "^5.1",
        "livewire/livewire": "^4.0",
        "maennchen/zipstream-php": "^3.1",
        "spatie/image": "^3.8",
        "spatie/temporary-directory": "^2.3",
        "stevebauman/purify": "^6.3",
        "tallstackui/tallstackui": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@test:unit",
            "@test:browser:groups"
        ],
        "test:unit": "@php vendor/bin/pest --parallel --processes=2 --compact --exclude-group=browser --default-time-limit=60",
        "test:feature": "@php vendor/bin/pest tests/Feature --parallel --processes=2 --compact --exclude-group=browser --default-time-limit=60",
        "test:browser": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120",
        "test:browser:groups": [
            "@test:browser:galleries",
            "@test:browser:shares",
            "@test:browser:admin",
            "@test:browser:features",
            "@test:browser:misc"
        ],
        "test:browser:galleries": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120 resources/views/pages/galleries/⚡show.test.php resources/views/pages/galleries/⚡show-browser.test.php resources/views/pages/galleries/⚡show-sharing.test.php resources/views/pages/galleries/photos/⚡show.test.php",
        "test:browser:shares": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120 resources/views/pages/shares/⚡show.test.php resources/views/pages/shares/photos/⚡show.test.php",
        "test:browser:admin": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120 resources/views/pages/admin/⚡emails.test.php resources/views/pages/admin/⚡queue.test.php resources/views/pages/admin/⚡stats.test.php resources/views/pages/admin/⚡translations.test.php",
        "test:browser:features": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120 tests/Feature/BlackScreenPageTest.php tests/Feature/DashboardUpcomingEventsTest.php tests/Feature/GalleryMasonryLayoutTest.php",
        "test:browser:misc": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120 resources/views/pages/branding/⚡watermark.test.php resources/views/pages/portfolio/⚡show.test.php resources/views/pages/⚡contracts.test.php resources/views/pages/⚡galleries.test.php resources/views/pages/⚡register.test.php resources/views/pages/⚡search.test.php resources/views/pages/⚡users.test.php",
        "test:dirty": "@php vendor/bin/pest --dirty --parallel --processes=2 --compact --exclude-group=browser --default-time-limit=60",
        "test:dirty:browser": "@php vendor/bin/pest --dirty --compact --group=browser --default-time-limit=120",
        "test:profile": "@php vendor/bin/pest --parallel --processes=2 --compact --exclude-group=browser --default-time-limit=60 --profile",
        "test:browser:file": "@php vendor/bin/pest --compact --group=browser --default-time-limit=120",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "coverage": "@php vendor/bin/pest --compact --exclude-group=browser --default-time-limit=120 --coverage --coverage-clover=coverage.xml",
        "preflight": [
            "@php vendor/bin/pint --dirty",
            "@php artisan optimize:clear",
            "@php artisan config:cache",
            "@php artisan route:cache",
            "@php artisan view:cache",
            "@php artisan optimize:clear",
            "npm run build",
            "@php artisan migrate:status",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 900,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
